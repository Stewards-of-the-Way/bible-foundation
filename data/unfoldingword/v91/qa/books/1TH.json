ourceLine":49,"originalId":"j9n0","originalReference":"5:18"},"book":"1TH","reference":"5:18","question":"What does Paul say that the believers should do in everything, and why?","answer":"Paul says that the believers should give thanks in everything, because this is the will of God for them.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"1TH","chapter":5,"verse":18,"endVerse":null,"scope":"1TH.5.18","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:1TH:5:20-21:gwld","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_1TH.tsv","sourceLine":50,"originalId":"gwld","originalReference":"5:20-21"},"book":"1TH","reference":"5:20-21","question":"What instructions does Paul give the believers about prophecies?","answer":"Paul instructs the believers to not despise prophecies, and to test all things, holding on to that which is good.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"1TH","chapter":5,"verse":20,"endVerse":21,"scope":"1TH.5.20","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:1TH:5:23:uvxs","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_1TH.tsv","sourceLine":51,"originalId":"uvxs","originalReference":"5:23"},"book":"1TH","reference":"5:23","question":"What does Paul pray that God will do for the believers?","answer":"Paul prays that God will sanctify the believers completely in spirit, soul, and body.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"1TH","chapter":5,"verse":23,"endVerse":null,"scope":"1TH.5.23","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:1TH:5:28:pn17","source":