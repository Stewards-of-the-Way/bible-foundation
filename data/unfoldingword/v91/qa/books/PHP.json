","Occurrence":"0"},"scriptureTargets":[{"book":"PHP","chapter":1,"verse":22,"endVerse":24,"scope":"PHP.1.22","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:PHP:1:25:wciu","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_PHP.tsv","sourceLine":14,"originalId":"wciu","originalReference":"1:25"},"book":"PHP","reference":"1:25","question":"For what purpose was Paul confident that he would remain with the Philippians?","answer":"Paul was confident that he would remain with the Philippians for their progress and joy in the faith.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"PHP","chapter":1,"verse":25,"endVerse":null,"scope":"PHP.1.25","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:PHP:1:27:zd8v","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_PHP.tsv","sourceLine":15,"originalId":"zd8v","originalReference":"1:27"},"book":"PHP","reference":"1:27","question":"Whether with the Philippians or away from them, what did Paul want to hear about the Philippians?","answer":"Paul wanted to hear that the Philippians stood fast in one spirit, with one soul striving together for the faith of the gospel.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"PHP","chapter":1,"verse":27,"endVerse":null,"scope":"PHP.1.27","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:PHP:1:28:qv5m","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_PHP.tsv","sourceLine":16,"originalId":"qv5m","originalReference":"1:28"},"book":"PHP","reference":"1:28","question":"When the Philippians did not fear those opposing the