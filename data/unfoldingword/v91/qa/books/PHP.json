,"endVerse":null,"scope":"PHP.1.11","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:PHP:1:12-14:gdhi","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_PHP.tsv","sourceLine":8,"originalId":"gdhi","originalReference":"1:12-14"},"book":"PHP","reference":"1:12-14","question":"How had Paul’s imprisonment advanced the gospel?","answer":"Paul’s imprisonment for Christ had become widely known, and most of the brothers were now speaking with more boldness.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"PHP","chapter":1,"verse":12,"endVerse":14,"scope":"PHP.1.12","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:PHP:1:17:qqp5","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_PHP.tsv","sourceLine":9,"originalId":"qqp5","originalReference":"1:17"},"book":"PHP","reference":"1:17","question":"Why were some proclaiming Christ out of selfish and insincere motives?","answer":"Some were proclaiming Christ out of selfish and insincere motives thinking they were adding to Paul’s affliction in prison.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"PHP","chapter":1,"verse":17,"endVerse":null,"scope":"PHP.1.17","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:PHP:1:18:m7cv","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_PHP.tsv","sourceLine":10,"originalId":"m7cv","originalReference":"1:18"},"book":"PHP","reference":"1:18","question":"What was Paul’s reaction to the sincere and insincere preaching of Christ?","answer":"Paul rejoiced that, either way, Christ was being proclaimed.","sourceFields":{"