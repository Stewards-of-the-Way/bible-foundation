stion":"What happened when Elijah prayed again, this time for rain?","answer":"When he prayed again, the heaven gave rain and the earth produced fruit.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"JAS","chapter":5,"verse":18,"endVerse":null,"scope":"JAS.5.18","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:JAS:5:20:c28q","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_JAS.tsv","sourceLine":73,"originalId":"c28q","originalReference":"5:20"},"book":"JAS","reference":"5:20","question":"What does someone accomplish who leads a sinner out of the error of his way?","answer":"The person who leads a sinner out of the error of his way saves a soul from death and covers a multitude of sins.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"JAS","chapter":5,"verse":20,"endVerse":null,"scope":"JAS.5.20","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"}]}
