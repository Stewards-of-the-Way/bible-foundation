Id":"pm2q","originalReference":"1:17"},"book":"RUT","reference":"1:17","question":"How long did Ruth say she would remain with Naomi?","answer":"She said she would remain with Naomi until they died. She said, “In the place where you die, I will die, and there I will be buried. May Yahweh do thus to me, and thus may he add, if death separates between me and between you.”","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"RUT","chapter":1,"verse":17,"endVerse":null,"scope":"RUT.1.17","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:RUT:1:19:ahzc","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_RUT.tsv","sourceLine":12,"originalId":"ahzc","originalReference":"1:19"},"book":"RUT","reference":"1:19","question":"To which town did Naomi return?","answer":"She returned to Bethlehem.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"RUT","chapter":1,"verse":19,"endVerse":null,"scope":"RUT.1.19","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:RUT:1:20:us6s","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_RUT.tsv","sourceLine":13,"originalId":"us6s","originalReference":"1:20"},"book":"RUT","reference":"1:20","question":"What name did Naomi want to be called and why?","answer":"She asked to be called “Mara” (which means “bitter”), because she believed that Yahweh had dealt bitterly with her.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"RUT","chapter":1,"verse":20,"endVerse":null,"scope":"RUT.1.20","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:RUT:1:22:f327","source":{"publisher":"unfoldingWord