":null,"scope":"2TH.2.8","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:2:9:gek1","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":17,"originalId":"gek1","originalReference":"2:9"},"book":"2TH","reference":"2:9","question":"Who is working with the man of lawlessness to give him power, signs, and false wonders?","answer":"Satan is working with the man of lawlessness to give him power, signs, and false wonders.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":2,"verse":9,"endVerse":null,"scope":"2TH.2.9","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:2:10:fdlk","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":18,"originalId":"fdlk","originalReference":"2:10"},"book":"2TH","reference":"2:10","question":"Why are some deceived by the man of lawlessness and are perishing?","answer":"Some are deceived because they did not receive the love of the truth, that they might be saved.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":2,"verse":10,"endVerse":null,"scope":"2TH.2.10","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:2:12:oun0","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":19,"originalId":"oun0","originalReference":"2:12"},"book":"2TH","reference":"2:12","question":"In what do those who are deceived and perishing take pleasure?","answer":"Those who are deceived and perishing take pleasure in unrighteousness.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":2,"verse":12,"endVerse":null,"scope":"2TH.2.12","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:2:13-14:mrfp","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":20,"originalId":"mrfp","originalReference":"2:13-14"},"book":"2TH","reference":"2:13-14","question":"What did God choose for the Thessalonians to obtain through the gospel?","answer":"God chose for the Thessalonians to obtain the glory of the Lord Jesus Christ through the gospel.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":2,"verse":13,"endVerse":14,"scope":"2TH.2.13","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:2:15:nrvi","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":21,"originalId":"nrvi","originalReference":"2:15"},"book":"2TH","reference":"2:15","question":"What does Paul call the Thessalonians to do now that they have received the gospel?","answer":"Paul calls the Thessalonians to stand firm and to grasp the traditions that they were taught.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":2,"verse":15,"endVerse":null,"scope":"2TH.2.15","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:2:17:hvs1","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":22,"originalId":"hvs1","originalReference":"2:17"},"book":"2TH","reference":"2:17","question":"In what does Paul desire the Thessalonians to be established in their hearts?","answer":"Paul desires that the Thessalonians be established in every good work and word.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":2,"verse":17,"endVerse":null,"scope":"2TH.2.17","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:3:1:adu1","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":23,"originalId":"adu1","originalReference":"3:1"},"book":"2TH","reference":"3:1","question":"For what does Paul want the Thessalonians to pray regarding the word of the Lord?","answer":"Paul wants the Thessalonians to pray that the word of the Lord would spread rapidly and be glorified.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":3,"verse":1,"endVerse":null,"scope":"2TH.3.1","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:3:2:l2h7","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":24,"originalId":"l2h7","originalReference":"3:2"},"book":"2TH","reference":"3:2","question":"From whom does Paul wish to be delivered?","answer":"Paul wishes to be delivered from wicked and evil people who do not have faith.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":3,"verse":2,"endVerse":null,"scope":"2TH.3.2","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:3:4:ogez","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":25,"originalId":"ogez","originalReference":"3:4"},"book":"2TH","reference":"3:4","question":"What does Paul tell the Thessalonians to continue to do?","answer":"Paul tells the Thessalonians to continue to do the things he has commanded them.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":3,"verse":4,"endVerse":null,"scope":"2TH.3.4","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:3:6:edcy","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":26,"originalId":"edcy","originalReference":"3:6"},"book":"2TH","reference":"3:6","question":"How are the believers to react every brother who walks disorderly and not according to the traditions they received from Paul?","answer":"The believers are to avoid every brother who walks disorderly and not according to the traditions they received from Paul.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":3,"verse":6,"endVerse":null,"scope":"2TH.3.6","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:3:7-8:t5yn","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":27,"originalId":"t5yn","originalReference":"3:7-8"},"book":"2TH","reference":"3:7-8","question":"What example did Paul set for the Thessalonians regarding his work and support?","answer":"Paul labored night and day, paying for his food, and not being a burden to anyone.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TH","chapter":3,"verse":7,"endVerse":8,"scope":"2TH.3.7","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TH:3:10:ui5r","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TH.tsv","sourceLine":28,"originalId":"ui5r","originalReference":"3:10"},"b