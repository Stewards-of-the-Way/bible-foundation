":"91","bookFile":"en_tq/tq_2TI.tsv","sourceLine":14,"originalId":"ap2i","originalReference":"1:15"},"book":"2TI","reference":"1:15","question":"What did all of Paul’s Asian companions do to him?","answer":"All those in Asia turned away from Paul.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TI","chapter":1,"verse":15,"endVerse":null,"scope":"2TI.1.15","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TI:1:16:pdcf","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TI.tsv","sourceLine":15,"originalId":"pdcf","originalReference":"1:16"},"book":"2TI","reference":"1:16","question":"Why does Paul ask the Lord to grant mercy to the household of Onesiphorus?","answer":"Paul asks the Lord to grant mercy to the household of Onesiphorus because Onesiphorus refreshed Paul and was not ashamed of Paul’s chain.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TI","chapter":1,"verse":16,"endVerse":null,"scope":"2TI.1.16","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TI:1:17:l6ky","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_2TI.tsv","sourceLine":16,"originalId":"l6ky","originalReference":"1:17"},"book":"2TI","reference":"1:17","question":"What did Onesiphorus do for Paul when Paul was in Rome?","answer":"Onesiphorus diligently sought Paul in Rome and found him.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"2TI","chapter":1,"verse":17,"endVerse":null,"scope":"2TI.1.17","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:2TI:1:18:dvlm","source":{"publisher":"unfoldingWord","resource":"en_tq"