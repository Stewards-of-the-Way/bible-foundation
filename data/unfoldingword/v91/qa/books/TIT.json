ce":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":11,"originalId":"bb4z","originalReference":"1:9"},"book":"TIT","reference":"1:9","question":"What must an elder’s attitude be toward the message that he was taught?","answer":"He must hold tightly to it, and thus, be able to encourage and rebuke others.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":1,"verse":9,"endVerse":null,"scope":"TIT.1.9","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:1:11:fu01","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":12,"originalId":"fu01","originalReference":"1:11"},"book":"TIT","reference":"1:11","question":"What were the false teachers doing by their teaching?","answer":"They were upsetting whole households.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":1,"verse":11,"endVerse":null,"scope":"TIT.1.11","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:1:11:zqwf","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":13,"originalId":"zqwf","originalReference":"1:11"},"book":"TIT","reference":"1:11","question":"What did the false teachers want?","answer":"They wanted shameful profit.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":1,"verse":11,"endVerse":null,"scope":"TIT.1.11","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:1:13:ncbn","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":14,"originalId":"ncbn","originalReference":"1:13"},"book":"TIT","reference":"1:13","question":"How should an elder treat these false teachers who damage the church?","answer":"He must rebuke them severely so they might be sound in the faith.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":1,"verse":13,"endVerse":null,"scope":"TIT.1.13","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:1:14:l4re","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":15,"originalId":"l4re","originalReference":"1:14"},"book":"TIT","reference":"1:14","question":"To what did Paul say they should not pay attention?","answer":"They should not pay attention to Jewish myths and to commandments of men.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":1,"verse":14,"endVerse":null,"scope":"TIT.1.14","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:1:15:n9lr","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":16,"originalId":"n9lr","originalReference":"1:15"},"book":"TIT","reference":"1:15","question":"In an unbelieving man, what is corrupted?","answer":"Both his mind and conscience are corrupted.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":1,"verse":15,"endVerse":null,"scope":"TIT.1.15","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:1:16:feiw","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":17,"originalId":"feiw","originalReference":"1:16"},"book":"TIT","reference":"1:16","question":"Although the corrupted man professes to know God, how does he deny him?","answer":"He denies God through his actions.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":1,"verse":16,"endVerse":null,"scope":"TIT.1.16","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:2:l08x","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":18,"originalId":"l08x","originalReference":"2:2"},"book":"TIT","reference":"2:2","question":"What are some characteristics that older men in the church should have?","answer":"They should be temperate, dignified, sensible, and sound in faith, in love, and in perseverance.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":2,"endVerse":null,"scope":"TIT.2.2","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:3:piyt","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":19,"originalId":"piyt","originalReference":"2:3"},"book":"TIT","reference":"2:3","question":"What are some characteristics that older women in the church should have?","answer":"They should be reverent, sober, not be slanderers, be teachers of what is good.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":3,"endVerse":null,"scope":"TIT.2.3","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:4:ccz2","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":20,"originalId":"ccz2","originalReference":"2:4"},"book":"TIT","reference":"2:4","question":"What should the older women teach the younger women to do?","answer":"They should teach them to love and obey their husbands, and to love their children.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":4,"endVerse":null,"scope":"TIT.2.4","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:7:jlut","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":21,"originalId":"jlut","originalReference":"2:7"},"book":"TIT","reference":"2:7","question":"How should Titus present himself as an example of good works?","answer":"In his teaching, he should be uncorrupted, act with dignity, and deliver a sound message that is above criticism.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":7,"endVerse":null,"scope":"TIT.2.7","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:8:idm5","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":22,"originalId":"idm5","originalReference":"2:8"},"book":"TIT","reference":"2:8","question":"What will happen to those who oppose Titus if he is a good example?","answer":"Those who oppose him will be ashamed because they have nothing bad to say about him.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":8,"endVerse":null,"scope":"TIT.2.8","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:9:v4mn","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":23,"originalId":"v4mn","originalReference":"2:9"},"book":"TIT","reference":"2:9","question":"How are slaves who are believers to behave?","answer":"They are to obey their masters, be pleasing, and should not argue.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":9,"endVerse":null,"scope":"TIT.2.9","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:10:rmsh","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":24,"originalId":"rmsh","originalReference":"2:10"},"book":"TIT","reference":"2:10","question":"When Christian slaves behave as Paul has instructed, what effect will that have on others?","answer":"It will bring credit to the teaching about God our Savior.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":10,"endVerse":null,"scope":"TIT.2.10","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:11:n5o4","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":25,"originalId":"n5o4","originalReference":"2:11"},"book":"TIT","reference":"2:11","question":"Who can the grace of God save?","answer":"The grace of God can save everyone.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":11,"endVerse":null,"scope":"TIT.2.11","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:12:o3ri","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":26,"originalId":"o3ri","originalReference":"2:12"},"book":"TIT","reference":"2:12","question":"What does the grace of God train us to reject?","answer":"The grace of God trains us to reject godlessness and worldly passions.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":12,"endVerse":null,"scope":"TIT.2.12","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:13:ytj1","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":27,"originalId":"ytj1","originalReference":"2:13"},"book":"TIT","reference":"2:13","question":"What future event do believers look forward to receiving?","answer":"Believers look forward to receiving the blessed hope: the appearance of the glory of our great God and Savior Jesus Christ.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":13,"endVerse":null,"scope":"TIT.2.13","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:2:14:fk1b","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":28,"originalId":"fk1b","originalReference":"2:14"},"book":"TIT","reference":"2:14","question":"Why did Jesus give himself for us?","answer":"He gave himself in order to redeem us from lawlessness and to purify for himself a people who are zealous to do good works.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":2,"verse":14,"endVerse":null,"scope":"TIT.2.14","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:3:1:i6ns","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":29,"originalId":"i6ns","originalReference":"3:1"},"book":"TIT","reference":"3:1","q