"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":3,"verse":9,"endVerse":null,"scope":"TIT.3.9","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:3:10:lapn","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":36,"originalId":"lapn","originalReference":"3:10"},"book":"TIT","reference":"3:10","question":"Who should we reject after one or two warnings?","answer":"We should reject a divisive person.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":3,"verse":10,"endVerse":null,"scope":"TIT.3.10","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"},{"id":"utq:v91:TIT:3:14:i5lu","source":{"publisher":"unfoldingWord","resource":"en_tq","version":"91","bookFile":"en_tq/tq_TIT.tsv","sourceLine":37,"originalId":"i5lu","originalReference":"3:14"},"book":"TIT","reference":"3:14","question":"What must believers engage themselves in so that they will be fruitful?","answer":"Believers must learn to engage themselves in doing good works that provide for essential needs.","sourceFields":{"Tags":"","Quote":"","Occurrence":"0"},"scriptureTargets":[{"book":"TIT","chapter":3,"verse":14,"endVerse":null,"scope":"TIT.3.14","startOnlyForReaderLink":true}],"attributionId":"utq-v91","reviewStatus":"SOURCE_RECORD_UNALTERED_NOT_INDEPENDENTLY_FACT_CHECKED"}]}
