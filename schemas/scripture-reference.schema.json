{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stewards-of-the-way.github.io/schemas/scripture-reference.schema.json",
  "title": "Reference-only Scripture fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "book_code", "references"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "scripture_reference_set"},
    "book_code": {"type": "string", "pattern": "^[A-Z0-9]{3,8}$"},
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "chapter", "verse", "verse_text_present"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9]{3,8}\\.[1-9][0-9]*\\.[1-9][0-9]*$"},
          "chapter": {"type": "integer", "minimum": 1},
          "verse": {"type": "integer", "minimum": 1},
          "verse_text_present": {"const": false}
        }
      }
    }
  }
}
